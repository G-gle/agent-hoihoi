{
  "name": "agent-hoihoi-staging",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "observe": "node scripts/observation_admin.mjs",
    "dev": "wrangler dev --local --ip 127.0.0.1 --port 8787",
    "dev:db-check": "wrangler dev --local --ip 127.0.0.1 --port 8787 --var ENABLE_DB_CHECK:true",
    "db:migrate:local": "wrangler d1 migrations apply agent-hoihoi-staging-db --local",
    "db:rows:local": "wrangler d1 execute agent-hoihoi-staging-db --local --command \"SELECT count(*) AS remaining FROM environment_check\"",
    "db:migrate:remote": "wrangler d1 migrations apply agent-hoihoi-staging-db --remote --config .cloudflare/wrangler.staging.json",
    "db:rows:remote": "wrangler d1 execute agent-hoihoi-staging-db --remote --config .cloudflare/wrangler.staging.json --command \"SELECT count(*) AS remaining FROM environment_check\"",
    "prepare:cloudflare": "node scripts/prepare_cloudflare.mjs",
    "deploy:probe": "wrangler deploy --config .cloudflare/wrangler.probe.json",
    "deploy": "wrangler deploy --config .cloudflare/wrangler.staging.json",
    "deploy:db-check": "wrangler deploy --config .cloudflare/wrangler.staging.json --var ENABLE_DB_CHECK:true",
    "dry-run": "wrangler deploy --dry-run --outdir .cloudflare/dry-run",
    "test": "node --test tests/*.test.mjs",
    "verify:http": "node scripts/verify_worker.mjs",
    "verify:access": "node scripts/verify_access.mjs",
    "guestbook": "node scripts/guestbook_admin.mjs"
  },
  "devDependencies": {
    "wrangler": "4.151.3"
  }
}
